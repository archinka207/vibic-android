<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/vibicBackground"
    android:fitsSystemWindows="false">

    <!-- Заголовок + кнопка нового чата -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/vibic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Чаты"
            android:textSize="32sp"
            android:textColor="?attr/vibicBrand"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"/>

        <!-- Кнопка новый чат — фиолетовый круг с + -->
        <FrameLayout
            android:id="@+id/btnNewChat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_new_chat_button"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="+"
                android:textColor="?attr/vibicTextOnBrand"
                android:textSize="26sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:paddingBottom="2dp"/>
        </FrameLayout>
    </FrameLayout>

    <!-- Поиск -->
    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Поиск"
        android:textColorHint="?attr/vibicTextTertiary"
        android:textColor="?attr/vibicTextPrimary"
        android:background="@drawable/search_background"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:maxLines="1"
        android:singleLine="true"/>

    <!-- КОНТЕЙНЕР ДЛЯ ПЛАВАЮЩЕГО БАРА -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Контент -->
        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- НИЖНЯЯ ПАНЕЛЬ (капсула по центру) -->
        <FrameLayout
            android:id="@+id/bottomNavigationContainer"
            android:layout_width="wrap_content"
            android:layout_height="62dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="14dp"
            android:paddingHorizontal="6dp"
            android:background="@drawable/bg_floating_nav"
            android:elevation="8dp">

            <!-- Сами вкладки -->
            <LinearLayout
                android:id="@+id/bottomNavigation"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Чаты -->
                <LinearLayout
                    android:id="@+id/chatsTab"
                    android:layout_width="wrap_content"
                    android:minWidth="76dp"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="10dp"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/chatIcon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_chat"
                            app:tint="?attr/vibicBrand"/>
                        <TextView
                            android:id="@+id/chatBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:minWidth="16dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/bg_badge_purple"
                            android:gravity="center"
                            android:paddingHorizontal="4dp"
                            android:text="1"
                            android:textColor="?attr/vibicTextPrimary"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:visibility="gone"/>
                    </FrameLayout>
                    <TextView
                        android:id="@+id/chatText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Чаты"
                        android:textColor="?attr/vibicBrand"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:singleLine="true"/>
                </LinearLayout>

                <!-- Контакты -->
                <LinearLayout
                    android:id="@+id/contactsTab"
                    android:layout_width="wrap_content"
                    android:minWidth="76dp"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="10dp"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/contactsIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_contacts"
                        app:tint="?attr/vibicIcon"/>
                    <TextView
                        android:id="@+id/contactsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Контакты"
                        android:textColor="?attr/vibicTextTertiary"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:singleLine="true"/>
                </LinearLayout>

                <!-- Профиль -->
                <LinearLayout
                    android:id="@+id/profileTab"
                    android:layout_width="wrap_content"
                    android:minWidth="76dp"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="10dp"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/profileAvatarCard"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        app:cardCornerRadius="13dp"
                        app:cardBackgroundColor="?attr/vibicTextTertiary"
                        app:cardElevation="0dp">
                        <TextView
                            android:id="@+id/profileAvatarText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="А"
                            android:textSize="13sp"
                            android:textColor="?attr/vibicTextPrimary"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:visibility="visible"/>
                        <ImageView
                            android:id="@+id/profileAvatarImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"/>
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:id="@+id/profileText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Профиль"
                        android:textColor="?attr/vibicTextTertiary"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:singleLine="true"/>
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>
    </RelativeLayout>

</LinearLayout>