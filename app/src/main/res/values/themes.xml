<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Vibic" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowSoftInputMode">adjustResize</item>

        <item name="colorPrimary">@color/brand</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_text_primary</item>
        <item name="android:windowBackground">@color/light_bg</item>

        <item name="vibicBackground">@color/light_bg</item>
        <item name="vibicSurface">@color/light_surface</item>
        <item name="vibicSurfaceElevated">@color/light_surface_elev</item>

        <item name="vibicDivider">@color/light_divider</item>
        <item name="vibicStroke">@color/light_divider</item>
        <item name="vibicSheet">@color/light_surface</item>

        <item name="vibicTextPrimary">@color/light_text_primary</item>
        <item name="vibicTextSecondary">@color/light_text_secondary</item>
        <item name="vibicTextTertiary">@color/light_text_tertiary</item>
        <item name="vibicTextOnBrand">@color/white</item>

        <item name="android:statusBarColor">@color/light_bg</item>
        <item name="android:navigationBarColor">@color/light_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="vibicBrand">@color/brand</item>
        <item name="vibicBrandPressed">@color/brand_pressed</item>
        <item name="vibicBrandSubtle">@color/brand_subtle</item>

        <item name="vibicDanger">@color/danger</item>
        <item name="vibicSuccess">@color/success</item>
        <item name="vibicWarning">@color/warning</item>

        <item name="vibicBubbleIn">@color/light_bubble_in</item>
        <item name="vibicBubbleOut">@color/brand</item>
        <item name="vibicBubbleInText">@color/light_text_primary</item>
        <item name="vibicBubbleOutText">@color/white</item>

        <item name="vibicInputCapsule">@color/light_surface_elev</item>
        <item name="vibicIcon">@color/light_text_primary</item>
        <item name="vibicIconMuted">@color/light_text_secondary</item>
        <item name="vibicRipple">@color/brand_subtle</item>
        <item name="vibicScrim">#66000000</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>

    <style name="Theme.Vibic.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/dark_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.Vibic</item>
    </style>

    <style name="BottomSheetTheme" parent="Theme.Design.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:navigationBarColor">@color/light_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@color/light_surface</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="VibicAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">@color/dark_surface_elev</item>
        <item name="colorSurface">@color/dark_surface_elev</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorControlHighlight">@color/brand_subtle</item>
        <item name="buttonBarPositiveButtonStyle">@style/VibicAlertButton.Danger</item>
        <item name="buttonBarNegativeButtonStyle">@style/VibicAlertButton.Neutral</item>
        <item name="materialAlertDialogTitleTextStyle">@style/VibicAlertTitle</item>
    </style>

    <style name="VibicAlertTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VibicAlertButton.Neutral" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/brand</item>
    </style>

    <style name="VibicAlertButton.Danger" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/danger</item>
    </style>
</resources>
