<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="false">

    <!-- Заголовок -->
    <TextView
        android:id="@+id/Vibic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Чаты"
        android:textSize="32sp"
        android:textColor="#6A11CB"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

    <!-- Поиск -->
    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Поиск"
        android:textColorHint="#666666"
        android:textColor="#FFFFFF"
        android:background="@drawable/search_background"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:maxLines="1"
        android:singleLine="true"/>

    <!-- КОНТЕЙНЕР ДЛЯ ПЛАВАЮЩЕГО БАРА -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Контент -->
        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- НИЖНЯЯ ПАНЕЛЬ -->
        <FrameLayout
            android:id="@+id/bottomNavigationContainer"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_floating_nav"
            android:elevation="8dp">

            <!-- ПЛАВАЮЩАЯ КАПСУЛА -->
            <View
                android:id="@+id/tabIndicator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:background="@drawable/bg_tab_capsule"/>

            <!-- Сами вкладки -->
            <LinearLayout
                android:id="@+id/bottomNavigation"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <!-- Чаты -->
                <LinearLayout
                    android:id="@+id/chatsTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/chatIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_margin="2dp"
                            android:src="@drawable/ic_chat"
                            app:tint="#6A11CB"/>
                        <TextView
                            android:id="@+id/chatBadge"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/bg_badge_purple"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:visibility="visible"/>
                    </FrameLayout>
                    <TextView
                        android:id="@+id/chatText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Чаты"
                        android:textColor="#6A11CB"
                        android:textSize="11sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Контакты -->
                <LinearLayout
                    android:id="@+id/contactsTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/contactsIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_margin="2dp"
                        android:src="@drawable/ic_contacts"
                        app:tint="#808080"/>
                    <TextView
                        android:id="@+id/contactsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Контакты"
                        android:textColor="#808080"
                        android:textSize="11sp"/>
                </LinearLayout>

                <!-- Настройки -->
                <LinearLayout
                    android:id="@+id/callTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/callIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_margin="2dp"
                        android:src="@drawable/ic_settings"
                        app:tint="#808080"/>
                    <TextView
                        android:id="@+id/callText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Настройки"
                        android:textColor="#808080"
                        android:textSize="11sp"/>
                </LinearLayout>

                <!-- Профиль -->
                <LinearLayout
                    android:id="@+id/profileTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/profileAvatarCard"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_margin="2dp"
                        app:cardCornerRadius="11dp"
                        app:cardBackgroundColor="#808080"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/profileAvatarText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="А"
                            android:textSize="12sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:visibility="visible"/>

                        <ImageView
                            android:id="@+id/profileAvatarImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"/>

                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:id="@+id/profileText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Профиль"
                        android:textColor="#808080"
                        android:textSize="11sp"/>
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>
    </RelativeLayout>
</LinearLayout>