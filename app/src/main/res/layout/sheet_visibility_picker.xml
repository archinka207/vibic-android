<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <TextView
            android:id="@+id/sheetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/vibicTextPrimary" />

        <FrameLayout
            android:id="@+id/btnCloseSheet"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_close_button"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✕"
                android:textColor="?attr/vibicBrand" />
        </FrameLayout>
    </LinearLayout>

    <!-- Все -->
    <LinearLayout
        android:id="@+id/optionAll"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Все"
            android:textColor="?attr/vibicTextPrimary"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/checkAll"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check_done"
            app:tint="?attr/vibicBrand"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="20dp"
        android:background="?attr/vibicDivider" />

    <!-- Контакты -->
    <LinearLayout
        android:id="@+id/optionContacts"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Контакты"
            android:textColor="?attr/vibicTextPrimary"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/checkContacts"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check_done"
            app:tint="?attr/vibicBrand"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="20dp"
        android:background="?attr/vibicDivider" />

    <!-- Никто -->
    <LinearLayout
        android:id="@+id/optionNobody"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Никто"
            android:textColor="?attr/vibicTextPrimary"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/checkNobody"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check_done"
            app:tint="?attr/vibicBrand"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
