<?xml version="1.0" encoding="utf-8"?>
<!-- Строка секции «Управление каналом» -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:background="?selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="14dp"
        app:tint="?attr/vibicBrand"/>

    <TextView
        android:id="@+id/rowTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="?attr/vibicTextPrimary"
        android:textSize="15sp"/>

    <TextView
        android:id="@+id/rowValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:maxWidth="160dp"
        android:textColor="?attr/vibicTextSecondary"
        android:textSize="14sp"/>

    <ImageView
        android:id="@+id/rowChevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="?attr/vibicIcon"/>
</LinearLayout>
