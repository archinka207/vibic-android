<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="52dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF"
            android:background="?selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Контент"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <!-- Счётчик файлов -->
        <TextView
            android:id="@+id/mediaCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- Табы: Фото и Видео / Голосовые / Файлы / Ссылки -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabPhoto"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Фото и Видео"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_tab_selected"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tabVoice"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Голосовые"
                android:textColor="#888888"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_tab_unselected"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tabFiles"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Файлы"
                android:textColor="#888888"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_tab_unselected"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tabLinks"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Ссылки"
                android:textColor="#888888"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_tab_unselected"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Контент: сетка медиа -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Сетка фото/видео -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mediaGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="2dp"/>

        <!-- Пустое состояние -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📂"
                android:textSize="48sp"/>

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Нет медиафайлов"
                android:textColor="#888888"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- Загрузка -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#B366FF"
            android:visibility="visible"/>
    </FrameLayout>

</LinearLayout>