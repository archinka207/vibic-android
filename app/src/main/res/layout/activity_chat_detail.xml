<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/vibicBackground">

    <!-- ═══ ОСНОВНОЙ КОНТЕНТ ЧАТА ═══ -->
    <LinearLayout
        android:id="@+id/chatMainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Верхняя панель -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1FB366FF"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:background="?selectableItemBackgroundBorderless"/>

            <LinearLayout
                android:id="@+id/chatUserCapsule"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?selectableItemBackground"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="#B366FF"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_chat_avatar"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/chatUserName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end"/>
                    <TextView
                        android:id="@+id/chatUserStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="В сети"
                        android:textColor="#4CAF50"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Список сообщений -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messagesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false"
            android:scrollbars="vertical"/>

        <!-- ═══ НИЖНЯЯ ЗОНА ═══ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/inputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp"
                    android:gravity="bottom">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_chat_input_capsule"
                        android:minHeight="48dp">

                        <LinearLayout
                            android:id="@+id/replyBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="4dp"
                            android:paddingTop="8dp"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/ic_menu_revert"
                                app:tint="#B366FF"
                                android:layout_marginEnd="8dp"/>

                            <View
                                android:layout_width="2dp"
                                android:layout_height="32dp"
                                android:background="#B366FF"
                                android:layout_marginEnd="8dp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/replyBarSenderName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#B366FF"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:maxLines="1"
                                    android:ellipsize="end"/>

                                <TextView
                                    android:id="@+id/replyBarText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#888888"
                                    android:textSize="12sp"
                                    android:maxLines="1"
                                    android:ellipsize="end"/>
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/replyBarThumb"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:scaleType="centerCrop"
                                android:background="@drawable/bg_reply_thumb"
                                android:visibility="gone"
                                android:layout_marginEnd="4dp"/>

                            <ImageView
                                android:id="@+id/replyBarClose"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@android:drawable/ic_menu_close_clear_cancel"
                                app:tint="#888888"
                                android:padding="8dp"
                                android:background="?selectableItemBackgroundBorderless"/>
                        </LinearLayout>

                        <View
                            android:id="@+id/replyDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#33B366FF"
                            android:visibility="gone"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="4dp">

                            <ImageView
                                android:id="@+id/attachButton"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_chat_add"
                                android:background="?selectableItemBackgroundBorderless"/>

                            <EditText
                                android:id="@+id/messageInput"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Type your message..."
                                android:textColorHint="#6B6A78"
                                android:textColor="#FFFFFF"
                                android:background="@null"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="12dp"
                                android:maxLines="4"
                                android:inputType="textMultiLine|textCapSentences"
                                android:textSize="15sp"/>

                            <ImageView
                                android:id="@+id/emojiButton"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_chat_emoji"
                                android:background="?selectableItemBackgroundBorderless"
                                android:layout_marginEnd="8dp"/>

                            <ImageView
                                android:id="@+id/videoNoteButton"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_camera"
                                app:tint="#B366FF"
                                android:padding="4dp"
                                android:background="?selectableItemBackgroundBorderless"
                                android:layout_marginEnd="4dp"/>

                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp">

                                <ImageView
                                    android:id="@+id/sendButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/ic_send"
                                    app:tint="#B366FF"
                                    android:padding="6dp"
                                    android:background="?selectableItemBackgroundBorderless"
                                    android:visibility="gone"/>

                                <ImageView
                                    android:id="@+id/micButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/ic_mic"
                                    app:tint="#B366FF"
                                    android:padding="6dp"
                                    android:background="?selectableItemBackgroundBorderless"/>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ПАНЕЛЬ СМАЙЛОВ -->
                <LinearLayout
                    android:id="@+id/emojiPanelContainer"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:orientation="vertical"
                    android:background="#121212"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp"
                        android:background="#1A1A1A">

                        <EditText
                            android:id="@+id/emojiSearchInput"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:background="@drawable/search_background"
                            android:drawableStart="@drawable/ic_search"
                            android:drawablePadding="8dp"
                            android:hint="Поиск смайликов..."
                            android:textColorHint="#888888"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:paddingHorizontal="12dp"
                            android:maxLines="1"
                            android:singleLine="true"/>

                        <ImageView
                            android:id="@+id/keyboardButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_keyboard"
                            app:tint="#B366FF"
                            android:background="?selectableItemBackgroundBorderless"/>
                    </LinearLayout>

                    <androidx.emoji2.emojipicker.EmojiPickerView
                        android:id="@+id/emojiPicker"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Запись голосового (Свайп) -->
            <LinearLayout
                android:id="@+id/recordingLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_chat_input_capsule"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <View
                        android:id="@+id/recordingDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_recording_dot"/>

                    <TextView
                        android:id="@+id/recordingTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="0:00"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:minWidth="40dp"/>

                    <LinearLayout
                        android:id="@+id/slideToCancelLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="◀"
                            android:textColor="#666666"
                            android:textSize="11sp"/>
                        <TextView
                            android:id="@+id/slideToCancelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Сдвиньте для отмены"
                            android:textColor="#666666"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lockLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒"
                            android:textSize="16sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Залоченная запись (Lock mode - ПАУЗА И 1X ЗДЕСЬ) -->
            <LinearLayout
                android:id="@+id/lockedRecordingLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/deleteRecordingButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="#FF453A"
                    android:padding="12dp"
                    android:background="?selectableItemBackgroundBorderless"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_chat_input_capsule"
                    android:paddingHorizontal="14dp"
                    android:layout_marginHorizontal="8dp">

                    <View
                        android:id="@+id/lockedDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_recording_dot"/>

                    <TextView
                        android:id="@+id/lockedTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="0:00"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:minWidth="40dp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <!-- Кнопка 1x -->
                    <TextView
                        android:id="@+id/viewOnceButton"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/bg_badge_purple"
                        android:alpha="0.4"
                        android:layout_marginEnd="16dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <!-- Пауза/Плей -->
                    <ImageView
                        android:id="@+id/pauseRecordingButton"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@android:drawable/ic_media_pause"
                        app:tint="#B366FF"
                        android:background="?selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"/>

                </LinearLayout>

                <FrameLayout
                    android:id="@+id/sendLockedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_send_button">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_send"
                        app:tint="#FFFFFF"
                        android:padding="12dp"/>
                </FrameLayout>
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

    <!-- ═══ ОВЕРЛЕЙ КРУЖОЧКА ═══ -->
    <FrameLayout
        android:id="@+id/videoNoteOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <androidx.cardview.widget.CardView
                android:layout_width="260dp"
                android:layout_height="260dp"
                app:cardCornerRadius="130dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent">


                <androidx.camera.view.PreviewView
                    android:id="@+id/cameraPreviewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <androidx.camera.view.PreviewView
                    android:id="@+id/cameraPreviewViewB"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="invisible"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/videoNoteTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="0:00"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="invisible"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/videoNoteCancelButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:background="@drawable/bg_record_button_inner"
                    android:padding="12dp"/>

                <FrameLayout
                    android:id="@+id/videoNoteRecordButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginHorizontal="24dp"
                    android:background="@drawable/bg_record_button"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/videoNoteRecordInner"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_record_button_inner"/>
                </FrameLayout>

                <ImageView
                    android:id="@+id/videoNoteFlipButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_camera"
                    app:tint="#FFFFFF"
                    android:background="@drawable/bg_record_button_inner"
                    android:padding="12dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/videoNoteHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Нажмите ● для записи"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp"/>
        </LinearLayout>
    </FrameLayout>

    <!-- ═══ OVERLAY КОНТЕКСТНОГО МЕНЮ (Telegram-style) ═══ -->
    <FrameLayout
        android:id="@+id/contextMenuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/clonedMessageContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <!-- Меню действий и Реакции (Без изменений) -->
            <LinearLayout
                android:id="@+id/actionsMenu"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_message_context_menu"
                android:paddingVertical="6dp"
                android:elevation="4dp">

                <LinearLayout
                    android:id="@+id/actionReply"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?selectableItemBackground">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_revert"
                        android:layout_marginEnd="14dp"
                        app:tint="#FFFFFF"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ответить"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionCopy"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?selectableItemBackground">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_view"
                        android:layout_marginEnd="14dp"
                        app:tint="#FFFFFF"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Копировать"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionForward"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?selectableItemBackground">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_share"
                        android:layout_marginEnd="14dp"
                        app:tint="#FFFFFF"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Переслать"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionPin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?selectableItemBackground">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_upload"
                        android:layout_marginEnd="14dp"
                        app:tint="#FFFFFF"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Закрепить"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionEdit"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?selectableItemBackground"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_edit"
                        android:layout_marginEnd="14dp"
                        app:tint="#FFFFFF"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Редактировать"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2C2C2E"
                    android:layout_marginVertical="4dp"/>

                <LinearLayout
                    android:id="@+id/actionDelete"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?selectableItemBackground">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_delete"
                        android:layout_marginEnd="14dp"
                        app:tint="#FF453A"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Удалить"
                        android:textColor="#FF453A"
                        android:textSize="15sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reactionsBar"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:background="@drawable/bg_message_reactions"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:gravity="center_vertical"
                android:elevation="4dp">

                <TextView android:layout_width="40dp" android:layout_height="40dp"
                    android:gravity="center" android:text="👍" android:textSize="22sp"
                    android:background="?selectableItemBackgroundBorderless"/>
                <TextView android:layout_width="40dp" android:layout_height="40dp"
                    android:gravity="center" android:text="❤️" android:textSize="22sp"
                    android:background="?selectableItemBackgroundBorderless"/>
                <TextView android:layout_width="40dp" android:layout_height="40dp"
                    android:gravity="center" android:text="😂" android:textSize="22sp"
                    android:background="?selectableItemBackgroundBorderless"/>
                <TextView android:layout_width="40dp" android:layout_height="40dp"
                    android:gravity="center" android:text="😮" android:textSize="22sp"
                    android:background="?selectableItemBackgroundBorderless"/>
                <TextView android:layout_width="40dp" android:layout_height="40dp"
                    android:gravity="center" android:text="🔥" android:textSize="22sp"
                    android:background="?selectableItemBackgroundBorderless"/>
                <TextView android:layout_width="40dp" android:layout_height="40dp"
                    android:gravity="center" android:text="😢" android:textSize="22sp"
                    android:background="?selectableItemBackgroundBorderless"/>

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_close_button">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_chevron_right"
                        android:rotation="90"
                        app:tint="#FFFFFF"/>
                </FrameLayout>
            </LinearLayout>

        </FrameLayout>
    </FrameLayout>
</FrameLayout>