<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Превью камеры -->
    <androidx.camera.view.PreviewView
        android:id="@+id/qrPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>

    <!-- Затемнение по краям (оверлей с квадратным окном) -->
    <com.example.vibic.QrOverlayView
        android:id="@+id/qrOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Кнопка назад -->
    <ImageView
        android:id="@+id/btnQrBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="52dp"
        android:padding="8dp"
        android:src="@drawable/ic_back"
        android:background="@drawable/bg_close_button"
        android:tint="?attr/vibicTextPrimary"/>

    <!-- Подсказка -->
    <TextView
        android:id="@+id/qrHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="80dp"
        android:text="Наведите камеру на QR-код профиля"
        android:textColor="?attr/vibicTextPrimary"
        android:textSize="15sp"
        android:background="#66000000"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:gravity="center"/>

</FrameLayout>