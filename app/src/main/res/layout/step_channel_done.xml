<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="32dp">

    <!-- АВАТАР С ПУЛЬСИРУЮЩИМ КОЛЬЦОМ -->
    <!--
        Внешний контейнер шире аватара на 40dp (по 20dp с каждой стороны),
        чтобы кольцо имело отступ 20dp от аватара (как просил пользователь).
        Аватар 100dp -> контейнер 140dp.
    -->
    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="140dp">

        <!-- ПУЛЬСИРУЮЩЕЕ КОЛЬЦО (2px фиолетовая рамка). Совпадает по размеру с контейнером. -->
        <View
            android:id="@+id/pulseRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/bg_pulse_ring"/>

        <!-- АВАТАР 100dp по центру -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_group_avatar">

            <TextView
                android:id="@+id/doneAvatarLetter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="M"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/doneAvatarImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"/>

            <!-- Зелёный кружок с галочкой -->
            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/bg_done_check_badge">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check_done"
                    app:tint="#FFFFFF"/>
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/doneTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Вайб создан!"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/doneSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="«Мой вайб» готов принимать ваши посты. Поделитесь ссылкой, чтобы пригласить подписчиков."
        android:textColor="#88FFFFFF"
        android:textSize="14sp"
        android:gravity="center"/>

</LinearLayout>