<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp">

    <!-- Кнопка play -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_record_button">

        <ImageView
            android:id="@+id/playButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play_audio"
            app:tint="?attr/vibicTextPrimary"/>
    </FrameLayout>

    <!-- Волна + дата -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <SeekBar
            android:id="@+id/audioSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="?attr/vibicBrand"
            android:thumbTint="?attr/vibicBrand"
            android:max="100"/>

        <TextView
            android:id="@+id/audioDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/vibicTextSecondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Длительность -->
    <TextView
        android:id="@+id/audioDuration"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:text="0:00"
        android:textColor="?attr/vibicTextSecondary"
        android:textSize="12sp"
        android:gravity="end"
        android:layout_marginStart="8dp"/>

</LinearLayout>