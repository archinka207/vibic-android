<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_auth_gradient"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Регистрация"
        android:textSize="34sp"
        android:textColor="#B366FF"
        android:textStyle="bold"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Войдите в свой круг Vibic"
        android:layout_gravity="center"
        android:textSize="17sp"
        android:textColor="#9966CC"
        android:layout_marginBottom="48dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Номер телефона"
        android:textSize="14sp"
        android:textColor="#9966CC"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/phoneInput"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="+7 (___) ___-__-__"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:background="@drawable/edittext_backround"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:gravity="center_vertical"
        android:inputType="phone"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Мы отправим код подтверждения"
        android:textSize="15sp"
        android:textColor="#9966CC"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/continueButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Продолжить"
        android:textSize="17sp"
        android:textColor="#FFFF"
        android:backgroundTint="#6A11CB"
        app:cornerRadius="12dp"
        android:textStyle="bold"/>

</LinearLayout>