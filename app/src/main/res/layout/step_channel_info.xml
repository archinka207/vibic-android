<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="32dp">

        <!-- АВАТАРКА -->
        <FrameLayout
            android:id="@+id/channelAvatarContainer"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_group_avatar"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/channelAvatarLetter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="M"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/channelAvatarImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"/>

            <!-- + badge -->
            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/bg_avatar_edit_badge">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
            </FrameLayout>
        </FrameLayout>

        <!-- НАЗВАНИЕ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_channel_input"
            android:padding="14dp"
            android:layout_marginTop="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="НАЗВАНИЕ"
                android:textColor="#88B366FF"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/channelNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Мой вайб"
                android:textColorHint="#55FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:background="@null"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_marginTop="2dp"
                android:padding="0dp"
                android:imeOptions="actionNext"/>
        </LinearLayout>

        <!-- ОПИСАНИЕ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_channel_input"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="ОПИСАНИЕ"
                    android:textColor="#88B366FF"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/descriptionCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/200"
                    android:textColor="#55FFFFFF"
                    android:textSize="11sp"/>
            </LinearLayout>

            <EditText
                android:id="@+id/channelDescriptionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="О чём этот канал? Что подписчики здесь увидят?"
                android:textColorHint="#55FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:background="@null"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="200"
                android:layout_marginTop="2dp"
                android:padding="0dp"
                android:gravity="top|start"
                android:minLines="2"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Название и описание увидят все, кто получит ссылку на вайб."
            android:textColor="#66FFFFFF"
            android:textSize="12sp"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>