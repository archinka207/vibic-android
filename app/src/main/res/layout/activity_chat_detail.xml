<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/vibicBackground">

    <!-- ═══ ОСНОВНОЙ КОНТЕНТ ЧАТА ═══ -->
    <LinearLayout
        android:id="@+id/chatMainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Верхняя панель -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="?attr/vibicBackground"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                app:tint="?attr/vibicIcon"
                android:clickable="true"
                android:focusable="true"
                android:background="?selectableItemBackgroundBorderless"/>

            <LinearLayout
                android:id="@+id/chatUserCapsule"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?selectableItemBackground"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="?attr/vibicBrand"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_chat_avatar"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/chatUserName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/vibicTextPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end"/>
                    <TextView
                        android:id="@+id/chatUserStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="В сети"
                        android:textColor="?attr/vibicSuccess"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Поиск по чату (вместо капсулы собеседника) -->
            <LinearLayout
                android:id="@+id/searchBar"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/search_background"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/vibicTextSecondary"/>

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingHorizontal="8dp"
                    android:background="@null"
                    android:hint="Поиск"
                    android:textColorHint="?attr/vibicTextSecondary"
                    android:textColor="?attr/vibicTextPrimary"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text"/>

                <ImageView
                    android:id="@+id/searchClear"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_clear"
                    app:tint="?attr/vibicTextSecondary"
                    android:background="?selectableItemBackgroundBorderless"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="?attr/vibicDivider"/>

        <!-- Список + плавающее поле ввода поверх него -->
        <FrameLayout
            android:id="@+id/chatBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <!-- Список сообщений (нижний отступ под капсулу задаётся из кода) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messagesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="92dp"
            android:clipToPadding="false"
            android:scrollbars="vertical"/>

        <!-- ═══ НИЖНЯЯ ЗОНА ═══ -->
        <FrameLayout
            android:id="@+id/bottomArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/inputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Плавающая капсула: 12dp по бокам, 8dp сверху, 16dp снизу -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="16dp"
                    android:clipToPadding="false"
                    android:gravity="bottom">

                    <LinearLayout
                        android:id="@+id/composerCapsule"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_composer_capsule"
                        android:elevation="12dp"
                        android:outlineAmbientShadowColor="@color/composer_shadow"
                        android:outlineSpotShadowColor="@color/composer_shadow"
                        android:minHeight="56dp">

                        <LinearLayout
                            android:id="@+id/replyBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="4dp"
                            android:paddingTop="8dp"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/ic_menu_revert"
                                app:tint="?attr/vibicBrand"
                                android:layout_marginEnd="8dp"/>

                            <View
                                android:layout_width="2dp"
                                android:layout_height="32dp"
                                android:background="?attr/vibicBrand"
                                android:layout_marginEnd="8dp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/replyBarSenderName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="?attr/vibicBrand"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:maxLines="1"
                                    android:ellipsize="end"/>

                                <TextView
                                    android:id="@+id/replyBarText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="?attr/vibicTextSecondary"
                                    android:textSize="12sp"
                                    android:maxLines="1"
                                    android:ellipsize="end"/>
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/replyBarThumb"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:scaleType="centerCrop"
                                android:background="@drawable/bg_reply_thumb"
                                android:visibility="gone"
                                android:layout_marginEnd="4dp"/>

                            <ImageView
                                android:id="@+id/replyBarClose"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@android:drawable/ic_menu_close_clear_cancel"
                                app:tint="?attr/vibicTextSecondary"
                                android:padding="8dp"
                                android:background="?selectableItemBackgroundBorderless"/>
                        </LinearLayout>

                        <View
                            android:id="@+id/replyDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#33B366FF"
                            android:visibility="gone"/>

                        <!-- «+» · текст · эмодзи · запись/отправить. Кнопки прижаты к низу,
                             при одной строке — по центру капсулы 56dp -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="bottom"
                            android:minHeight="56dp"
                            android:paddingHorizontal="12dp">

                            <ImageView
                                android:id="@+id/attachButton"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginBottom="11dp"
                                android:padding="8dp"
                                android:src="@drawable/ic_composer_plus"
                                app:tint="@color/composer_muted"
                                android:background="@drawable/bg_composer_plus"/>

                            <EditText
                                android:id="@+id/messageInput"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:minHeight="56dp"
                                android:hint="Сообщение"
                                android:textColorHint="@color/composer_muted"
                                android:textColor="@color/composer_text"
                                android:textCursorDrawable="@drawable/composer_cursor"
                                android:background="@null"
                                android:paddingHorizontal="0dp"
                                android:paddingTop="17dp"
                                android:paddingBottom="17dp"
                                android:gravity="center_vertical|start"
                                android:maxLines="5"
                                android:inputType="textMultiLine|textCapSentences"
                                android:textSize="16sp"/>

                            <ImageView
                                android:id="@+id/emojiButton"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginBottom="13dp"
                                android:padding="3dp"
                                android:src="@drawable/ic_composer_emoji"
                                app:tint="@color/composer_muted"
                                android:background="?selectableItemBackgroundBorderless"/>

                            <ImageView
                                android:id="@+id/videoNoteButton"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginBottom="13dp"
                                android:padding="3dp"
                                android:src="@drawable/ic_composer_video_note"
                                app:tint="@color/composer_accent"
                                android:background="?selectableItemBackgroundBorderless"/>

                            <FrameLayout
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginBottom="9dp">

                                <ImageView
                                    android:id="@+id/sendButton"
                                    android:layout_width="38dp"
                                    android:layout_height="38dp"
                                    android:padding="9dp"
                                    android:src="@drawable/ic_composer_send"
                                    android:background="@drawable/bg_composer_send"
                                    android:visibility="gone"/>

                                <ImageView
                                    android:id="@+id/micButton"
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:layout_gravity="center"
                                    android:padding="5dp"
                                    android:src="@drawable/ic_composer_mic"
                                    app:tint="@color/composer_accent"
                                    android:background="?selectableItemBackgroundBorderless"/>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ПАНЕЛЬ СМАЙЛОВ -->
                <LinearLayout
                    android:id="@+id/emojiPanelContainer"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:orientation="vertical"
                    android:background="?attr/vibicSurface"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp"
                        android:background="?attr/vibicSurface">

                        <EditText
                            android:id="@+id/emojiSearchInput"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:background="@drawable/search_background"
                            android:drawableStart="@drawable/ic_search"
                            android:drawablePadding="8dp"
                            android:hint="Поиск смайликов..."
                            android:textColorHint="?attr/vibicTextSecondary"
                            android:textColor="?attr/vibicTextPrimary"
                            android:textSize="14sp"
                            android:paddingHorizontal="12dp"
                            android:maxLines="1"
                            android:singleLine="true"/>

                        <ImageView
                            android:id="@+id/keyboardButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_keyboard"
                            app:tint="?attr/vibicBrand"
                            android:background="?selectableItemBackgroundBorderless"/>
                    </LinearLayout>

                    <androidx.emoji2.emojipicker.EmojiPickerView
                        android:id="@+id/emojiPicker"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Навигация по результатам поиска -->
            <LinearLayout
                android:id="@+id/searchNavBar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="?attr/vibicBackground"
                android:visibility="gone">

                <TextView
                    android:id="@+id/searchCounter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/vibicTextSecondary"
                    android:textSize="15sp"/>

                <ImageView
                    android:id="@+id/searchUp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:rotation="-90"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/vibicBrand"
                    android:background="?selectableItemBackgroundBorderless"/>

                <ImageView
                    android:id="@+id/searchDown"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:rotation="90"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/vibicBrand"
                    android:background="?selectableItemBackgroundBorderless"/>
            </LinearLayout>

            <!-- Запись голосового (Свайп) -->
            <LinearLayout
                android:id="@+id/recordingLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_chat_input_capsule"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <View
                        android:id="@+id/recordingDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_recording_dot"/>

                    <TextView
                        android:id="@+id/recordingTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="0:00"
                        android:textColor="?attr/vibicTextPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:minWidth="40dp"/>

                    <LinearLayout
                        android:id="@+id/slideToCancelLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/slideArrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="‹"
                            android:textColor="?attr/vibicTextSecondary"
                            android:textSize="22sp"/>
                        <TextView
                            android:id="@+id/slideToCancelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Влево — отмена"
                            android:textColor="?attr/vibicTextSecondary"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lockLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒"
                            android:textSize="16sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Залоченная запись (Lock mode - ПАУЗА И 1X ЗДЕСЬ) -->
            <LinearLayout
                android:id="@+id/lockedRecordingLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/deleteRecordingButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="?attr/vibicDanger"
                    android:padding="12dp"
                    android:background="?selectableItemBackgroundBorderless"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_chat_input_capsule"
                    android:paddingHorizontal="14dp"
                    android:layout_marginHorizontal="8dp">

                    <View
                        android:id="@+id/lockedDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_recording_dot"/>

                    <TextView
                        android:id="@+id/lockedTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="0:00"
                        android:textColor="?attr/vibicTextPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:minWidth="40dp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <!-- Кнопка 1x -->
                    <TextView
                        android:id="@+id/viewOnceButton"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:text="1"
                        android:textColor="?attr/vibicTextPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/bg_badge_purple"
                        android:alpha="0.4"
                        android:layout_marginEnd="16dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <!-- Пауза/Плей -->
                    <ImageView
                        android:id="@+id/pauseRecordingButton"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@android:drawable/ic_media_pause"
                        app:tint="?attr/vibicBrand"
                        android:background="?selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"/>

                </LinearLayout>

                <FrameLayout
                    android:id="@+id/sendLockedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_send_button">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_send"
                        app:tint="?attr/vibicTextPrimary"
                        android:padding="12dp"/>
                </FrameLayout>
            </LinearLayout>

        </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ═══ ОВЕРЛЕЙ КРУЖОЧКА ═══ -->
    <FrameLayout
        android:id="@+id/videoNoteOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/videoNoteCircle"
                android:layout_width="276dp"
                android:layout_height="276dp">

            <com.example.vibic.VideoProgressRingView
                android:id="@+id/videoNoteProgress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <androidx.cardview.widget.CardView
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center"
                app:cardCornerRadius="130dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#000000">


                <androidx.camera.view.PreviewView
                    android:id="@+id/cameraPreviewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <androidx.camera.view.PreviewView
                    android:id="@+id/cameraPreviewViewB"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="invisible"/>
            </androidx.cardview.widget.CardView>
            </FrameLayout>

            <TextView
                android:id="@+id/videoNoteTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="0:00"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="invisible"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/videoNoteCancelButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:background="@drawable/bg_record_button_inner"
                    android:padding="12dp"/>

                <FrameLayout
                    android:id="@+id/videoNoteRecordButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginHorizontal="24dp"
                    android:background="@drawable/bg_record_button"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/videoNoteRecordInner"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_record_button_inner"/>
                </FrameLayout>

                <ImageView
                    android:id="@+id/videoNoteFlipButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_camera"
                    app:tint="?attr/vibicTextPrimary"
                    android:background="@drawable/bg_record_button_inner"
                    android:padding="12dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/videoNoteHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Нажмите ● для записи"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp"/>
        </LinearLayout>
    </FrameLayout>

    <!-- ═══ АНИМАЦИИ ЗАПИСИ (круг, замок, корзина) — позиции задаются из кода ═══ -->
    <FrameLayout
        android:id="@+id/recordOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <LinearLayout
            android:id="@+id/lockPill"
            android:layout_width="40dp"
            android:layout_height="72dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_lock_pill"
            android:visibility="gone">

            <ImageView
                android:id="@+id/lockIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_lock_channel"
                app:tint="?attr/vibicTextSecondary"/>

            <ImageView
                android:id="@+id/lockArrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                android:rotation="-90"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/vibicTextSecondary"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/cancelTrash"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_trash"
            app:tint="?attr/vibicTextSecondary"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/cancelMic"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_mic"
            app:tint="?attr/vibicDanger"
            android:visibility="gone"/>

        <com.example.vibic.RecordCircleView
            android:id="@+id/recordCircle"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:visibility="gone"/>
    </FrameLayout>

    <!-- ═══ OVERLAY КОНТЕКСТНОГО МЕНЮ (Telegram-style) ═══ -->
    <FrameLayout
        android:id="@+id/contextMenuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/clonedMessageContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <!-- Меню действий и Реакции (Без изменений) -->
            <LinearLayout
                android:id="@+id/actionsMenu"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_message_context_menu"
                android:paddingVertical="6dp"
                android:elevation="4dp">

                <LinearLayout
                    android:id="@+id/actionReply"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?selectableItemBackground">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_revert"
                        android:layout_marginEnd="14dp"
                        app:tint="?attr/vibicTextPrimary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ответить"
                        android:textColor="?attr/vibicTextPrimary"
                        android:textSize="15sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionCopy"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?selectableItemBackground">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_view"
                        android:layout_marginEnd="14dp"
                        app:tint="?attr/vibicTextPrimary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Копировать"
                        android:textColor="?attr/vibicTextPrimary"
                        android:textSize="15sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionForward"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?selectableItemBackground">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_share"
                        android:layout_marginEnd="14dp"
                        app:tint="?attr/vibicTextPrimary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Переслать"
                        android:textColor="?attr/vibicTextPrimary"
                        android:textSize="15sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionPin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?selectableItemBackground">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_upload"
                        android:layout_marginEnd="14dp"
                        app:tint="?attr/vibicTextPrimary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Закрепить"
                        android:textColor="?attr/vibicTextPrimary"
                        android:textSize="15sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionEdit"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?selectableItemBackground"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_edit"
                        android:layout_marginEnd="14dp"
                        app:tint="?attr/vibicTextPrimary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Редактировать"
                        android:textColor="?attr/vibicTextPrimary"
                        android:textSize="15sp"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/vibicDivider"
                    android:layout_marginVertical="4dp"/>

                <LinearLayout
                    android:id="@+id/actionDelete"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?selectableItemBackground">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_delete"
                        android:layout_marginEnd="14dp"
                        app:tint="?attr/vibicDanger"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Удалить"
                        android:textColor="?attr/vibicDanger"
                        android:textSize="15sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reactionsBar"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:background="@drawable/bg_message_reactions"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:gravity="center_vertical"
                android:elevation="4dp">

                <TextView android:layout_width="40dp" android:layout_height="40dp"
                    android:gravity="center" android:text="👍" android:textSize="22sp"
                    android:background="?selectableItemBackgroundBorderless"/>
                <TextView android:layout_width="40dp" android:layout_height="40dp"
                    android:gravity="center" android:text="❤️" android:textSize="22sp"
                    android:background="?selectableItemBackgroundBorderless"/>
                <TextView android:layout_width="40dp" android:layout_height="40dp"
                    android:gravity="center" android:text="😂" android:textSize="22sp"
                    android:background="?selectableItemBackgroundBorderless"/>
                <TextView android:layout_width="40dp" android:layout_height="40dp"
                    android:gravity="center" android:text="😮" android:textSize="22sp"
                    android:background="?selectableItemBackgroundBorderless"/>
                <TextView android:layout_width="40dp" android:layout_height="40dp"
                    android:gravity="center" android:text="🔥" android:textSize="22sp"
                    android:background="?selectableItemBackgroundBorderless"/>
                <TextView android:layout_width="40dp" android:layout_height="40dp"
                    android:gravity="center" android:text="😢" android:textSize="22sp"
                    android:background="?selectableItemBackgroundBorderless"/>

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_close_button">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_chevron_right"
                        android:rotation="90"
                        app:tint="?attr/vibicTextPrimary"/>
                </FrameLayout>
            </LinearLayout>

        </FrameLayout>
    </FrameLayout>
</FrameLayout>