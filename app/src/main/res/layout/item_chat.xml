<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/item_chat.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/ripple_chat_item"
    android:clickable="true"
    android:focusable="true">

    <!-- Аватарка -->
    <androidx.cardview.widget.CardView
        android:id="@+id/avatarCard"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="12dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/vibicBrand">

        <ImageView
            android:id="@+id/avatarImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_chat_avatar"
            android:scaleType="centerCrop"/>

        <TextView
            android:id="@+id/avatarText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:visibility="gone"/>
    </androidx.cardview.widget.CardView>

    <!-- Информация о чате -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_gravity="center_vertical">

        <!-- Имя + иконка mute -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Имя контакта"
                android:textColor="?attr/vibicTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- Иконка "без звука", по умолчанию скрыта -->
            <ImageView
                android:id="@+id/muteIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_chat_muted"
                app:tint="?attr/vibicIcon"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Последнее сообщение -->
        <TextView
            android:id="@+id/lastMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Последнее сообщение"
            android:textColor="?attr/vibicTextSecondary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- Правая колонка: время сверху, бейдж или булавка под ним (как на макете) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/lastMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:00"
            android:textColor="?attr/vibicTextTertiary"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/unreadBadge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="10sp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_unread_badge"
            android:visibility="gone"/>

        <!-- Булавка закреплённого чата (показывается, если нет непрочитанных) -->
        <ImageView
            android:id="@+id/pinIndicator"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="3dp"
            android:rotation="45"
            android:src="@drawable/ic_action_pin"
            app:tint="?attr/vibicTextSecondary"
            android:visibility="gone"/>
    </LinearLayout>

</LinearLayout>