<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="20dp">

    <!-- Грабер -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottom_sheet_handle"/>

    <!-- Заголовок -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Уведомления"
        android:textColor="?attr/vibicTextPrimary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingHorizontal="20dp"/>

    <TextView
        android:id="@+id/sheetSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/vibicTextSecondary"
        android:textSize="14sp"
        android:paddingHorizontal="20dp"
        android:paddingTop="2dp"
        android:paddingBottom="16dp"/>

    <!-- ── Блок переключателей ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_background"
        android:layout_marginHorizontal="16dp"
        android:paddingVertical="4dp">

        <!-- Уведомления -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_notifications"
                app:tint="?attr/vibicBrand"
                android:layout_marginEnd="16dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Уведомления"
                    android:textColor="?attr/vibicTextPrimary"
                    android:textSize="16sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Получать сообщения из группы"
                    android:textColor="?attr/vibicTextSecondary"
                    android:textSize="13sp"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <com.example.vibic.IosSwitch
                android:id="@+id/switchNotifications"
                android:layout_width="51dp"
                android:layout_height="31dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:background="?attr/vibicSurface"/>

        <!-- Показывать текст -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chat"
                app:tint="?attr/vibicBrand"
                android:layout_marginEnd="16dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Показывать текст"
                    android:textColor="?attr/vibicTextPrimary"
                    android:textSize="16sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Превью сообщения в шторке"
                    android:textColor="?attr/vibicTextSecondary"
                    android:textSize="13sp"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <com.example.vibic.IosSwitch
                android:id="@+id/switchPreview"
                android:layout_width="51dp"
                android:layout_height="31dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:background="?attr/vibicSurface"/>

        <!-- Вибрация -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_vibration"
                app:tint="?attr/vibicBrand"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Вибрация"
                android:textColor="?attr/vibicTextPrimary"
                android:textSize="16sp"/>

            <com.example.vibic.IosSwitch
                android:id="@+id/switchVibration"
                android:layout_width="51dp"
                android:layout_height="31dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ── Звук ── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ЗВУК"
        android:textColor="?attr/vibicTextSecondary"
        android:textSize="12sp"
        android:letterSpacing="0.06"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_background"
        android:layout_marginHorizontal="16dp"
        android:paddingVertical="4dp">

        <!-- По умолчанию -->
        <LinearLayout
            android:id="@+id/soundDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?selectableItemBackground">

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="14dp">
                <View
                    android:id="@+id/soundDefaultRing"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_radio_unselected"/>
                <View
                    android:id="@+id/soundDefaultDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_radio_selected"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="По умолчанию"
                android:textColor="?attr/vibicTextPrimary"
                android:textSize="16sp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:background="?attr/vibicSurface"/>

        <!-- Колокольчик -->
        <LinearLayout
            android:id="@+id/soundBell"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?selectableItemBackground">

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="14dp">
                <View
                    android:id="@+id/soundBellRing"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_radio_unselected"/>
                <View
                    android:id="@+id/soundBellDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_radio_selected"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Колокольчик"
                android:textColor="?attr/vibicTextPrimary"
                android:textSize="16sp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:background="?attr/vibicSurface"/>

        <!-- Без звука -->
        <LinearLayout
            android:id="@+id/soundSilent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?selectableItemBackground">

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="14dp">
                <View
                    android:id="@+id/soundSilentRing"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_radio_unselected"/>
                <View
                    android:id="@+id/soundSilentDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_radio_selected"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Без звука"
                android:textColor="?attr/vibicTextPrimary"
                android:textSize="16sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Отключить на 1 час -->
    <LinearLayout
        android:id="@+id/btnMuteHour"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_mute_hour_button"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notifications"
            app:tint="?attr/vibicDanger"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Отключить на 1 час"
            android:textColor="?attr/vibicDanger"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>