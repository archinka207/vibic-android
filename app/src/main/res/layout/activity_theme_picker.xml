<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/vibicBackground"
    android:orientation="vertical">

    <!-- ───── TOP BAR ───── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            app:tint="?attr/vibicIcon"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Тема оформления"
            android:textColor="?attr/vibicTextPrimary"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- ───── OPTIONS CARD ───── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_background"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp">

        <!-- Светлая -->
        <LinearLayout
            android:id="@+id/optionLight"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Светлая"
                android:textColor="?attr/vibicTextPrimary"
                android:textSize="16sp"/>

            <ImageView
                android:id="@+id/checkLight"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check_done"
                app:tint="?attr/vibicBrand"
                android:visibility="invisible"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginHorizontal="20dp"
            android:background="?attr/vibicDivider"/>

        <!-- Тёмная -->
        <LinearLayout
            android:id="@+id/optionDark"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Тёмная"
                android:textColor="?attr/vibicTextPrimary"
                android:textSize="16sp"/>

            <ImageView
                android:id="@+id/checkDark"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check_done"
                app:tint="?attr/vibicBrand"
                android:visibility="invisible"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginHorizontal="20dp"
            android:background="?attr/vibicDivider"/>

        <!-- Как в системе -->
        <LinearLayout
            android:id="@+id/optionSystem"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Как в системе"
                android:textColor="?attr/vibicTextPrimary"
                android:textSize="16sp"/>

            <ImageView
                android:id="@+id/checkSystem"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check_done"
                app:tint="?attr/vibicBrand"
                android:visibility="invisible"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
