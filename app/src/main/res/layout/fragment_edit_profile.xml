<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editProfileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/vibicBackground"
    android:fitsSystemWindows="true">

    <!-- ВЕРХНЯЯ ПАНЕЛЬ: назад, заголовок, Готово -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="?attr/vibicTextPrimary"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Назад"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Редактировать профиль"
            android:textColor="?attr/vibicTextPrimary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сохранить"
            android:textColor="?attr/vibicBrand"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:background="?selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- АВАТАР -->
            <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/editAvatarCard"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#8E44FF">

                    <ImageView
                        android:id="@+id/editAvatarImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/editAvatarText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textSize="44sp"
                        android:textStyle="bold"
                        android:textColor="?attr/vibicTextPrimary"
                        tools:text="O"/>
                </androidx.cardview.widget.CardView>

                <!-- Маленький фиолетовый кружок с карандашом -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/avatarEditBadge"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/vibicBrand"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_edit_top"
                        android:tint="?attr/vibicTextPrimary"/>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- ИМЯ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ИМЯ"
                android:textColor="#88FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/inputFirstName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_edit_profile_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="?attr/vibicTextPrimary"
                android:textColorHint="#66FFFFFF"
                android:textSize="15sp"
                android:hint="Имя"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:imeOptions="actionNext"/>

            <!-- ИМЯ ПОЛЬЗОВАТЕЛЯ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ИМЯ ПОЛЬЗОВАТЕЛЯ"
                android:textColor="#88FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:layout_marginTop="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/inputUsername"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_edit_profile_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="?attr/vibicTextPrimary"
                android:textColorHint="#66FFFFFF"
                android:textSize="15sp"
                android:hint="@username"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionNext"/>

            <TextView
                android:id="@+id/usernamePreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="6dp"
                android:textColor="#66FFFFFF"
                android:textSize="12sp"
                tools:text="vibic.app/username"/>

            <!-- О СЕБЕ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="О СЕБЕ"
                android:textColor="#88FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:layout_marginTop="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/inputBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:background="@drawable/bg_edit_profile_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textColor="?attr/vibicTextPrimary"
                android:textColorHint="#66FFFFFF"
                android:textSize="15sp"
                android:hint="Расскажите о себе"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top|start"
                android:maxLength="70"
                android:imeOptions="actionDone"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Видно всем"
                    android:textColor="#66FFFFFF"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/bioCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#66FFFFFF"
                    android:textSize="12sp"
                    tools:text="70"/>
            </LinearLayout>

            <!-- Кнопка Выйти -->
            <LinearLayout
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_logout_tile"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_logout"
                    android:tint="#FF5C5C"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Выйти"
                    android:textColor="#FF5C5C"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>