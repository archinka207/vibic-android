<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/vibicBackground">

    <!-- ШАПКА: назад, заголовок, индикатор шага -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="52dp"
        android:paddingBottom="8dp"
        android:paddingHorizontal="16dp">

        <FrameLayout
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_send_button"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back"
                app:tint="?attr/vibicTextPrimary"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Закрытый вайб"
                android:textColor="?attr/vibicTextPrimary"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <!-- Шаг-индикатор: 3 палочки -->
            <LinearLayout
                android:id="@+id/stepDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <View
                    android:id="@+id/step1"
                    android:layout_width="26dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_step_active"
                    android:layout_marginEnd="4dp"/>

                <View
                    android:id="@+id/step2"
                    android:layout_width="26dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_step_inactive"
                    android:layout_marginEnd="4dp"/>

                <View
                    android:id="@+id/step3"
                    android:layout_width="26dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_step_inactive"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/stepCounter"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="1/3"
            android:textColor="?attr/vibicTextSecondary"
            android:textSize="13sp"
            android:gravity="end"/>
    </LinearLayout>

    <!-- ВНУТРЕННИЙ ПЕРЕКЛЮЧАТЕЛЬ ЭКРАНОВ -->
    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ========= ШАГ 1: ИМЯ + ОПИСАНИЕ ========= -->
        <include layout="@layout/step_channel_info"/>

        <!-- ========= ШАГ 2: ТИП ВАЙБА ========= -->
        <include layout="@layout/step_channel_type"/>

        <!-- ========= ШАГ 3: ПОДПИСЧИКИ ========= -->
        <include layout="@layout/step_channel_subscribers"/>

        <!-- ========= ШАГ 4: ГОТОВО ========= -->
        <include layout="@layout/step_channel_done"/>

    </ViewFlipper>

    <!-- НИЖНЯЯ ПАНЕЛЬ КНОПОК (меняется по шагам) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="32dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="120dp"
            android:layout_height="56dp"
            android:text="Пропустить"
            android:textColor="?attr/vibicTextPrimary"
            android:textSize="15sp"
            android:gravity="center"
            android:background="@drawable/bg_skip_button"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/btnPrimary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:text="Далее"
            android:textColor="?attr/vibicTextPrimary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_next_button"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</LinearLayout>